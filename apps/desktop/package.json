{
  "name": "@follo/desktop",
  "version": "0.21.0",
  "private": true,
  "description": "Local-first engineering intelligence",
  "author": "Montooth Design",
  "main": "dist/main.cjs",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.montooth.follo",
    "productName": "Follo",
    "electronVersion": "44.5.1",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "!dist/foundation.test.cjs",
      "!**/.env*",
      "!**/*.credential",
      "!**/*.credential.tmp",
      "!**/*.pem",
      "!**/*.key",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
