{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["node"],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@follo/shared": ["./packages/shared/src/index.ts"],
      "@follo/database": ["./packages/database/src/index.ts"],
      "@follo/parser": ["./packages/parser/src/index.ts"],
      "@follo/graph": ["./packages/graph/src/index.ts"],
      "@follo/search": ["./packages/search/src/index.ts"],
      "@follo/decisions": ["./packages/decisions/src/index.ts"],
      "@follo/llm": ["./packages/llm/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts"]
}
